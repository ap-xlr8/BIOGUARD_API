# =============================================================
# BioGuard API - Variables de entorno (PLANTILLA)
# =============================================================
# Copia este archivo a `.env` y completa los valores con TUS
# credenciales. NUNCA subas valores reales a git.
#
# Los valores REALES viven únicamente en:
#   - Variables de entorno de DigitalOcean App Platform (prod/staging)
#   - GitHub Secrets (CI/CD)
#   - Tu `.env` local (desarrollo, ignorado por git)
#
# Formato: todas las claves son de ejemplo, usa `tu_*_aqui`.
# =============================================================

# ---------- REQUERIDO ----------
# Cadena de conexion de MongoDB Atlas
MONGODB_CONNECTION_STRING=mongodb+srv://tu_usuario:tu_contrasena@tu_cluster.mongodb.net/bioguard

# Clave de firma JWT (minimo 32 caracteres)
JWT_SECRET_KEY=tu_clave_secreta_jwt_aqui

# Redis es obligatorio en produccion para rate limiting distribuido.
REDIS_CONNECTION_STRING=redis.tu-proveedor.internal:6379,password=tu_password,ssl=true,abortConnect=false

# ---------- Pagos ----------
STRIPE_SECRET_KEY=tu_clave_secreta_stripe_aqui
STRIPE_WEBHOOK_SECRET=tu_secreto_webhook_stripe_aqui
PAYPAL_CLIENT_ID=tu_client_id_paypal_aqui
PAYPAL_CLIENT_SECRET=tu_client_secret_paypal_aqui

# ---------- Notificaciones push (Firebase Cloud Messaging) ----------
FIREBASE_SERVICE_ACCOUNT_JSON=tu_service_account_json_en_base64_aqui
FIREBASE_PROJECT_ID=tu_project_id_firebase_aqui
FIREBASE_CREDENTIALS_PATH=/ruta/al/service-account.json

# ---------- OAuth Google ----------
GOOGLE_CLIENT_ID=tu_oauth_client_id.apps.googleusercontent.com

# ---------- SMTP (correos transaccionales) ----------
SMTP_HOST=smtp.tu_proveedor.com
SMTP_PORT=587
SMTP_USER=tu_usuario_smtp_aqui
SMTP_PASSWORD=tu_password_smtp_aqui
SMTP_FROM=noreply@bioguard.app

# ---------- Imagenes (ImgBB) ----------
IMGBB_API_KEY=tu_api_key_imgbb_aqui

# ---------- Cifrado de datos en reposo ----------
CRIPTO_KEY=tu_clave_de_cifrado_de_al_menos_32_caracteres

# ---------- Dispositivo biometrico / hosts permitidos ----------
BIOMETRIC_MAC_ADDRESS=wearos-001
ALLOWED_HOSTS=bioguard-api-lkvnq.ondigitalocean.app;bioguard.app

# IP del balanceador/reverse proxy que entrega X-Forwarded-For y X-Forwarded-Proto.
# Separe varias direcciones con punto y coma. Obligatorio en Production.
TRUSTED_PROXY_IPS=10.0.0.10
