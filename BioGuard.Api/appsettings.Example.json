{
  "// NOTA": "Plantilla de configuracion. Los valores REALES se inyectan por variables de entorno (App Platform / GitHub Secrets / .env). NO pongas credenciales reales aqui.",
  "ConnectionStrings": {
    "MongoDB": "mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/bioguard"
  },
  "Jwt": {
    "Key": "<tu-clave-secreta-min-32-caracteres>",
    "Issuer": "BioGuardApi",
    "Audience": "BioGuardApp",
    "ExpirationMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Google": {
    "ClientId": "<tu-oauth-client-id>.apps.googleusercontent.com"
  },
  "Stripe": {
    "SecretKey": "<tu-stripe-secret-key>",
    "WebhookSecret": "<tu-stripe-webhook-secret>",
    "PriceIdGratis": "<price-id>",
    "PriceIdPlus": "<price-id>",
    "PriceIdCare": "<price-id>",
    "PriceIdFamily": "<price-id>",
    "PriceIdProSalud": "<price-id>"
  },
  "PayPal": {
    "ClientId": "<tu-paypal-client-id>",
    "ClientSecret": "<tu-paypal-client-secret>",
    "WebhookId": "<tu-paypal-webhook-id>",
    "SandboxMode": true
  },
  "Firebase": {
    "ServiceAccountJson": "",
    "ProjectId": "<tu-project-id>",
    "CredentialsPath": "/ruta/al/service-account.json"
  },
  "ImgBB": {
    "ApiKey": "<tu-imgbb-api-key>",
    "BaseUrl": "https://api.imgbb.com/1/upload",
    "MaxFileSizeMb": 5
  },
  "Smtp": {
    "Host": "smtp.tu_proveedor.com",
    "Port": "587",
    "User": "<tu-usuario-smtp>",
    "Password": "<tu-password-smtp>",
    "From": "noreply@bioguard.app"
  },
  "Cors": {
    "AllowedOrigins": [ "https://bioguard.app" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
